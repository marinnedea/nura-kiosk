# nura-kiosk settings. After editing: sudo rc-service nura-kiosk restart

# Page to show. For Grafana dashboards append &kiosk (hides Grafana's menus) and
# &theme=dark (dark pixels are switched off on AMOLED screens: less power, less burn-in).
KIOSK_URL="https://play.grafana.org/d/to6j8mh/grafana-play-home?orgId=1&kiosk&theme=dark&refresh=1m"

# Screen rotation: normal (or 0) | 90 | 180 | 270
# Phones are portrait-native. Portrait (normal) is much smoother: in landscape (90/270) the
# compositor has to rotate every frame on the GPU, which makes scrolling and animations laggy.
KIOSK_TRANSFORM="normal"

# Compositor output scale. Keep 1: fractional values (e.g. 1.5) make the browser render at 2x
# and downscale, which is very slow on phone hardware. Use KIOSK_ZOOM for text size instead.
KIOSK_SCALE="1"

# Page zoom inside the browser (1.0 is tiny on a high-DPI phone screen; 1.5 is a good start)
KIOSK_ZOOM="1.5"

# Backlight brightness in percent (lower = less power, less heat, less burn-in)
KIOSK_BRIGHTNESS="35"

# Browser: firefox (recommended, usually GPU-accelerated) | chromium
KIOSK_BROWSER="firefox"

# Chromium only: off | angle-gles | angle-gl | egl  (see /usr/local/bin/nura-kiosk-session)
KIOSK_GPU="off"

# User the browser runs as (set by install.sh)
KIOSK_USER="user"

# Return to KIOSK_URL this many seconds after the last touch (0 = never)
KIOSK_IDLE_HOME="300"
