#!/bin/sh
# Runs inside cage (the Wayland kiosk compositor): set rotation/scale, then run the browser fullscreen.
. /etc/conf.d/nura-kiosk

OUT=$(wlr-randr 2>/dev/null | awk 'NR==1{print $1}')
[ -n "$OUT" ] && wlr-randr --output "$OUT" --transform "${KIOSK_TRANSFORM:-90}" --scale "${KIOSK_SCALE:-1}"

# Wait (up to ~2 min) until the page's host resolves, so we don't land on a DNS error page after boot
HOST=$(echo "$KIOSK_URL" | sed -E 's|^[a-z]+://([^/:?]+).*|\1|')
i=0
while [ $i -lt 60 ] && ! nslookup "$HOST" >/dev/null 2>&1; do
	sleep 2; i=$((i + 1))
done

# Load the device's session environment. Nura device packages put per-device tweaks here,
# e.g. GPU driver workarounds like FD_MESA_DEBUG=nobin on msm8953 phones.
for f in /etc/profile.d/*.sh; do
	[ -r "$f" ] && . "$f"
done

run_firefox() {
	PROFILE="$HOME/.cache/nura-kiosk-firefox"
	mkdir -p "$PROFILE"
	# Kiosk-friendly prefs, rewritten on every start
	cat > "$PROFILE/user.js" <<'EOF'
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.startup.homepage_override.mstone", "ignore");
user_pref("browser.aboutwelcome.enabled", false);
user_pref("datareporting.policy.dataSubmissionEnabled", false);
user_pref("toolkit.telemetry.reportingpolicy.firstRun", false);
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("browser.sessionstore.max_resumed_crashes", 0);
user_pref("app.update.auto", false);
user_pref("browser.tabs.warnOnClose", false);
user_pref("ui.systemUsesDarkTheme", 1);
user_pref("layout.css.prefers-color-scheme.content-override", 0);
user_pref("gfx.webrender.all", true);
user_pref("dom.w3c_touch_events.enabled", 1);
user_pref("apz.allow_zooming", false);
EOF
	# Zoom inside Firefox instead of fractional compositor scaling (renders at native resolution)
	echo "user_pref(\"layout.css.devPixelsPerPx\", \"${KIOSK_ZOOM:-1.5}\");" >> "$PROFILE/user.js"
	# Home page = dashboard, so Alt+Home (Volume Up, see nura-kiosk-keys) returns to it
	echo "user_pref(\"browser.startup.homepage\", \"${KIOSK_URL}\");" >> "$PROFILE/user.js"
	export MOZ_ENABLE_WAYLAND=1 MOZ_USE_XINPUT2=1
	exec dbus-run-session -- firefox --kiosk --no-remote --profile "$PROFILE" "$KIOSK_URL"
}

run_chromium() {
	PROFILE="$HOME/.cache/nura-kiosk-chromium"
	mkdir -p "$PROFILE"
	# Don't show "restore pages?" after an unclean shutdown
	sed -i 's/"exited_cleanly":false/"exited_cleanly":true/; s/"exit_type":"[^"]*"/"exit_type":"Normal"/' \
		"$PROFILE/Default/Preferences" 2>/dev/null

	# GPU mode (KIOSK_GPU in /etc/conf.d/nura-kiosk). What works depends on the phone's GPU driver;
	# on the tested Adreno 506 (freedreno) only "off" works:
	#   off        - software rendering only (stable, slow)
	#   angle-gles - ANGLE on OpenGL ES
	#   angle-gl   - ANGLE on desktop OpenGL
	#   egl        - Chromium's native EGL path
	case "${KIOSK_GPU:-off}" in
		angle-gles) GPU_FLAGS="--ignore-gpu-blocklist --use-gl=angle --use-angle=gles" ;;
		angle-gl)   GPU_FLAGS="--ignore-gpu-blocklist --use-gl=angle --use-angle=gl" ;;
		egl)        GPU_FLAGS="--ignore-gpu-blocklist --use-gl=egl" ;;
		*)          GPU_FLAGS="--disable-gpu --disable-gpu-compositing" ;;
	esac

	# dbus-run-session gives Chromium a session bus (silences D-Bus errors)
	exec dbus-run-session -- chromium \
		--ozone-platform=wayland \
		--kiosk \
		--user-data-dir="$PROFILE" \
		--no-first-run \
		--noerrdialogs \
		--disable-infobars \
		--disable-session-crashed-bubble \
		--disable-translate \
		--disable-features=Translate,MediaRouter,Vulkan \
		--disable-vulkan-surface \
		$GPU_FLAGS \
		--password-store=basic \
		--check-for-update-interval=31536000 \
		--force-dark-mode \
		--touch-events=enabled \
		--force-device-scale-factor="${KIOSK_ZOOM:-1.5}" \
		"$KIOSK_URL"
}

case "${KIOSK_BROWSER:-firefox}" in
	firefox) run_firefox ;;
	*)       run_chromium ;;
esac
